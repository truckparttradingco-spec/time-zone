<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#071326" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#0C1A2B"
                android:centerColor="#07111F" android:endColor="#050B14" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
