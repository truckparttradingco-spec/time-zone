<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/widget_bg"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:orientation="horizontal"
                android:gravity="center">
                <TextView android:id="@+id/city_flag_1" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="🇩🇪" android:textSize="17sp" android:includeFontPadding="false"/>
                <TextView android:id="@+id/city_name_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Berlin" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
            </LinearLayout>

            <TextView android:id="@+id/city_time_1" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:text="--:--" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" android:fontFamily="sans-serif" android:includeFontPadding="false"/>
            <TextView android:id="@+id/city_date_1" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:text="2 NOV" android:textColor="#E5ECF5" android:textSize="9sp" android:fontFamily="sans-serif" android:includeFontPadding="false"/>
            <TextView android:id="@+id/city_zone_1" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="3dp" android:background="@drawable/widget_utc_capsule" android:gravity="center" android:text="UTC+1:00" android:textColor="#F5C84C" android:textSize="9sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="66dp" android:background="#168CFF"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center">
                <TextView android:id="@+id/city_flag_2" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="🇹🇷" android:textSize="17sp" android:includeFontPadding="false"/>
                <TextView android:id="@+id/city_name_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Istanbul" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
            </LinearLayout>

            <TextView android:id="@+id/city_time_2" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:text="--:--" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" android:fontFamily="sans-serif" android:includeFontPadding="false"/>
            <TextView android:id="@+id/city_date_2" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:text="2 NOV" android:textColor="#E5ECF5" android:textSize="9sp" android:fontFamily="sans-serif" android:includeFontPadding="false"/>
            <TextView android:id="@+id/city_zone_2" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="3dp" android:background="@drawable/widget_utc_capsule" android:gravity="center" android:text="UTC+3:00" android:textColor="#F5C84C" android:textSize="9sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="66dp" android:background="#168CFF"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center">
                <TextView android:id="@+id/city_flag_3" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:text="🇨🇳" android:textSize="17sp" android:includeFontPadding="false"/>
                <TextView android:id="@+id/city_name_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Shanghai" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
            </LinearLayout>

            <TextView android:id="@+id/city_time_3" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:text="--:--" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" android:fontFamily="sans-serif" android:includeFontPadding="false"/>
            <TextView android:id="@+id/city_date_3" android:layout_width="match_parent" android:layout_height="15dp" android:gravity="center" android:text="2 NOV" android:textColor="#E5ECF5" android:textSize="9sp" android:fontFamily="sans-serif" android:includeFontPadding="false"/>
            <TextView android:id="@+id/city_zone_3" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="3dp" android:background="@drawable/widget_utc_capsule" android:gravity="center" android:text="UTC+8:00" android:textColor="#F5C84C" android:textSize="9sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
